---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "https://github.com/Srinivas26k/Hekara";
const email = "srinivasvarma764@gmail.com";

const interests = ["Custom features", "Integrations", "Hardened deployment", "Migration", "Compliance readiness", "Security review", "Support plan", "Commercial licence", "Sponsorship"];
const sizes = ["Just exploring", "1–25 caregivers", "26–100", "101–500", "500+", "Building a product"];
const timelines = ["This month", "1–3 months", "3–6 months", "Later / not sure"];
const budgets = ["Under $5k", "$5k–$20k", "$20k–$50k", "$50k+", "Not sure yet"];
---

<BaseLayout title="Start a project | Hekara" description="Tell us about your agency and what you need from Hekara: custom builds, integrations, deployment, compliance readiness or support.">
  <section class="page-hero" style="padding-bottom:0">
    <div class="wrap">
      <span class="label">Start a project</span>
      <h1 class="display" style="margin-top:24px;font-size:clamp(40px,6vw,76px)">Tell us what you're <span class="hl">trying to run.</span></h1>
      <p class="lede">Two minutes of context means a useful first reply instead of a round of questions.</p>
    </div>
  </section>

  <section class="band" style="padding-top:clamp(40px,6vw,72px)">
    <div class="wrap split split-form">
      <form class="form" id="lead-form" novalidate>
        <div class="row">
          <label class="field"><span>Your name</span><input class="input" name="name" autocomplete="name" required /></label>
          <label class="field"><span>Work email</span><input class="input" name="email" type="email" autocomplete="email" required /></label>
        </div>
        <div class="row">
          <label class="field"><span>Organisation</span><input class="input" name="org" autocomplete="organization" /></label>
          <label class="field"><span>Your role</span><input class="input" name="role" autocomplete="organization-title" placeholder="Owner, administrator, CTO…" /></label>
        </div>

        <fieldset class="fieldset">
          <legend>What do you need? <small class="muted">Pick any</small></legend>
          <div class="options">{interests.map((i) => <label class="option"><input type="checkbox" name="interest" value={i} /><span>{i}</span></label>)}</div>
        </fieldset>

        <fieldset class="fieldset">
          <legend>Agency size</legend>
          <div class="options">{sizes.map((s) => <label class="option"><input type="radio" name="size" value={s} /><span>{s}</span></label>)}</div>
        </fieldset>

        <div class="row">
          <fieldset class="fieldset">
            <legend>Timeline</legend>
            <div class="options">{timelines.map((s) => <label class="option"><input type="radio" name="timeline" value={s} /><span>{s}</span></label>)}</div>
          </fieldset>
          <fieldset class="fieldset">
            <legend>Budget range</legend>
            <div class="options">{budgets.map((s) => <label class="option"><input type="radio" name="budget" value={s} /><span>{s}</span></label>)}</div>
          </fieldset>
        </div>

        <fieldset class="fieldset">
          <legend>How would you like to contract?</legend>
          <div class="options">{["Freelance, directly with Srinivas", "We need a company contract (NDA, MSA, vendor onboarding)", "Not sure yet"].map((s) => <label class="option"><input type="radio" name="contract" value={s} /><span>{s}</span></label>)}</div>
        </fieldset>

        <label class="field"><span>How did you hear about Hekara?</span>
          <select class="input" name="heard" id="heard">
            <option value="">Choose one</option>
            <option>Product Hunt</option><option>GitHub</option><option>Search engine</option><option>AI assistant (ChatGPT, Claude, Perplexity…)</option><option>LinkedIn</option><option>Reddit or Hacker News</option><option>A colleague</option><option>Other</option>
          </select>
        </label>

        <label class="field"><span>What should we know?</span>
          <textarea class="input" name="message" required placeholder="How you schedule today, the systems you use, what has to change, any deadline or audit coming up."></textarea>
          <small>Please don't include patient names or any health information.</small>
        </label>

        <div class="actions">
          <button class="btn btn-primary btn-lg" type="submit">Send to Hekara <span class="arrow">→</span></button>
          <span class="form-status" id="form-status" role="status"></span>
        </div>
        <p class="small muted">Sending opens your email app with your answers filled in, so nothing is stored on this site. Prefer to write yourself? <a href={`mailto:${email}`}>{email}</a></p>
      </form>

      <aside class="stack-lg sticky">
        <div class="card">
          <h2 class="h4">What happens next?</h2>
          <ul class="ticks" style="margin-top:18px">
            <li>We read every message and reply personally</li>
            <li>If it's a fit, a short intro call</li>
            <li>A written scope and quote before any work</li>
          </ul>
        </div>
        <div class="card">
          <h2 class="h4">Other ways to reach us</h2>
          <ul class="ticks" style="margin-top:18px">
            <li><a href={`${repo}/issues`} target="_blank" rel="noopener">Bugs and feature requests</a> on GitHub</li>
            <li><a href={`${repo}/discussions`} target="_blank" rel="noopener">Questions</a> in Discussions</li>
            <li><a href={`${repo}/blob/main/SECURITY.md`} target="_blank" rel="noopener">Security issues</a>: report privately</li>
            <li><a href={`${base}sponsor`}>Sponsor</a> the project</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline define:vars={{ email }}>
    document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('lead-form');
    const status = document.getElementById('form-status');
    let source = '';
    try {
      const src = JSON.parse(sessionStorage.getItem('hekara_src') || 'null');
      if (src) {
        source = Object.entries(src).map(([k, v]) => `${k}=${v}`).join('; ');
        const hint = (src.utm_source || src.ref || '').toLowerCase();
        const map = { producthunt: 'Product Hunt', github: 'GitHub', linkedin: 'LinkedIn', reddit: 'Reddit or Hacker News', hackernews: 'Reddit or Hacker News', google: 'Search engine', bing: 'Search engine', chatgpt: 'AI assistant (ChatGPT, Claude, Perplexity…)', perplexity: 'AI assistant (ChatGPT, Claude, Perplexity…)' };
        const sel = document.getElementById('heard');
        if (map[hint]) sel.value = map[hint];
      }
    } catch (_) {}
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const name = String(d.get('name') || '').trim();
      const from = String(d.get('email') || '').trim();
      const msg = String(d.get('message') || '').trim();
      if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(from) || !msg) {
        status.textContent = 'Please add your name, a valid email and a short message.';
        return;
      }
      const interests = d.getAll('interest').join(', ') || 'Not specified';
      const org = String(d.get('org') || '').trim();
      const lines = [
        `Name: ${name}`,
        `Email: ${from}`,
        `Organisation: ${org || '-'}`,
        `Role: ${String(d.get('role') || '-')}`,
        `Interested in: ${interests}`,
        `Agency size: ${d.get('size') || '-'}`,
        `Timeline: ${d.get('timeline') || '-'}`,
        `Budget: ${d.get('budget') || '-'}`,
        `Contract: ${d.get('contract') || '-'}`,
        `Heard via: ${d.get('heard') || '-'}`,
        `Source: ${source || '-'}`,
        '',
        msg,
      ];
      const tag = String(d.get('contract') || '').startsWith('We need') ? 'Company' : 'Freelance';
      const subject = `Hekara lead [${tag}]: ${org || name} (${interests.split(',')[0]})`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
      status.textContent = 'Your email app should open with everything filled in. Just press send.';
    });
    });
  </script>
</BaseLayout>
