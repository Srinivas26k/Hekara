---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const repo = "https://github.com/Srinivas26k/Hekara";

const problems = [
  ["“Who is covering the 4 PM visit?”", "One live timeline of every caregiver and visit, updating in every open tab.", "The whole team sees the same day."],
  ["A caregiver calls out", "One-click Fill picks someone with the right skill, no overlap and room in their week. With Undo.", "Shifts covered in seconds, not an hour of calls."],
  ["Overtime found after payroll", "Overtime watch and Copilot suggestions move visits before the limit.", "Lower overtime cost, fewer surprises."],
  ["A CPR card or TB test lapses", "Credentials bucketed into expired, 30 days, 90 days and valid.", "Audit-ready records."],
  ["“What changed, and who did it?”", "A tamper-evident audit log with an integrity check.", "Evidence for reviews and auditors."],
  ["Per-seat fees and lock-in", "Self-hosted, portable, open source.", "You own your data and your costs."],
];

const features = [
  {
    id: "schedule",
    title: "A live schedule the whole agency shares",
    body: "Every caregiver and visit on one timeline, with a moving “now” marker and statuses that follow the clock.",
    ticks: ["Day and week views, filterable by caregiver", "Done, in progress, scheduled and needs-attention computed from the clock", "Updates in every open tab, no refresh"],
    img: "schedule.png",
    alt: "Hekara schedule timeline with caregivers, visits and open shifts",
  },
  {
    id: "shifts",
    title: "Fill open shifts in one click",
    body: "Hekara checks skill, overlap and the weekly limit before it suggests anyone. Copilot explains every suggestion, and the server checks it again when you apply it.",
    ticks: ["Eligibility checked on the server, with Undo", "Rule-based suggestions: no patient data leaves your server", "Overtime watch before payroll, not after"],
    img: "caregivers.png",
    alt: "Hekara caregiver list with skills, weekly load and availability",
  },
  {
    id: "compliance",
    title: "Credentials and care plans, never quietly expired",
    body: "Track CPR, TB tests, background checks and more. Care plans carry tasks, instructions and review dates, all encrypted.",
    ticks: ["Expired, 30-day, 90-day and valid buckets", "Overdue care-plan reviews flagged", "An attention list for the morning huddle"],
    img: "compliance.png",
    alt: "Hekara compliance tracker grouping credentials by expiry",
  },
  {
    id: "billing",
    title: "Billing and reports that match the schedule",
    body: "Claims move through a guarded workflow. Reports cover hours, fill rate, visits per day and claim totals.",
    ticks: ["Draft, submitted, paid or denied, with no skipped steps", "7, 14 and 30-day reports", "CSV export that neutralises spreadsheet formulas"],
    img: "billing.png",
    alt: "Hekara billing and claims workflow",
  },
];

const faqs = [
  ["What does Hekara cost?", "The software is free under the AGPL-3.0. You pay for your own hosting, which for a small agency can be a single modest server. Paid help with setup, custom features and compliance readiness is available."],
  ["Is it ready for production?", "Hekara is an alpha (v0.1). It runs end to end on Node and Postgres and is ready to evaluate, pilot and build on. It has not had an independent security audit. If you want to run it with real patient data, talk to us about a hardened deployment."],
  ["Is Hekara HIPAA compliant?", "No software is HIPAA compliant on its own; compliance is something your organisation achieves. Hekara provides technical safeguards: field-level encryption, audit logging, roles and strong sign-in. We can help with the rest of the program."],
  ["Can you get us a SOC 2 or ISO 27001 report?", "Reports are issued by independent audit firms. We do the readiness work: gap assessment, control mapping, policies, technical fixes and evidence, so you walk into the audit prepared."],
  ["Where can it run?", "Today: anywhere Node and Postgres run, including your own server, AWS, GCP, Azure or on-premises. A native Cloudflare adapter is next on the roadmap. The app talks to interfaces, not a specific cloud."],
  ["Can we change it, or use it in our own product?", "Yes. Change anything. The AGPL asks that network services built on a modified Hekara share their source; if that doesn't suit you, a commercial licence is available."],
];
---

<BaseLayout title="Hekara: open-source home health agency software" >
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="label">Free &amp; open source · For home health and home care agencies</span>
          <h1 class="display hero-h1" style="margin-top:24px">Scheduling software for home health agencies. <span class="hl">Free, private, and yours.</span></h1>
          <p class="lede">Hekara shows every caregiver and patient visit on one screen, fills empty shifts in one click, and warns you before overtime or expired certificates cost you money. It runs on your own server, so your patients' data stays with you.</p>
          <div class="actions">
            <a class="btn btn-primary btn-lg" href="#how-it-works">See how it works <span class="arrow">↓</span></a>
            <a class="btn btn-ghost btn-lg" href={`${base}services`}>Get it set up for us <span class="arrow">→</span></a>
          </div>
          <a class="ph-featured" href="https://www.producthunt.com/products/hekara?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-hekara" target="_blank" rel="noopener noreferrer"><img alt="Hekara - Home health agency operations you can self-host | Product Hunt" width="250" height="54" src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1328941&amp;theme=light&amp;t=1795690059248" /></a>
        </div>
        <ul class="hero-aside hero-points">
          <li><strong>No per-user fees</strong><span>Add every caregiver without adding cost</span></li>
          <li><strong>Patient data encrypted</strong><span>Locked before it is ever saved</span></li>
          <li><strong>Runs in your own cloud</strong><span>Your server, your account, your data</span></li>
          <li><strong>Open source</strong><span>Free to use, read and change</span></li>
        </ul>
      </div>
      <figure class="shot" style="margin-bottom:0">
        <div class="shot-bar"><i></i><i></i><i></i><span>Schedule · Juniper Home Health (demo data)</span></div>
        <img src={`${base}images/schedule.png`} alt="Hekara schedule: a live timeline of caregivers and visits with open shifts, Copilot suggestions and overtime watch" width="1600" height="1000" />
      </figure>
    </div>
  </section>


  <section class="band" id="what-is-hekara">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="label">In plain words</span>
          <h2 class="h2">What is Hekara?</h2>
        </div>
        <p class="lede">Hekara is free software that a home health agency uses to plan which caregiver visits which patient, and when. It also tracks staff certificates, billing and patient records, and keeps all of it private.</p>
      </div>
      <div class="cards cards-4 reveal">
        <article class="card"><h3>Who is it for?</h3><p>Home health and home care agencies: the owner, the people who build the schedule, the caregivers in the field and the billing team.</p></article>
        <article class="card"><h3>What does it replace?</h3><p>Spreadsheets, whiteboards, group chats and phone calls, or expensive software that charges for every user.</p></article>
        <article class="card"><h3>What does it cost?</h3><p>The software is free. You only pay for the server it runs on, or for our help if you want it set up for you.</p></article>
        <article class="card"><h3>Where does it run?</h3><p>On a server you control: your own machine, or your agency's account at AWS, Azure or Google Cloud. Your data never sits with us.</p></article>
      </div>
    </div>
  </section>

  <section class="band band-alt" id="how-it-works">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="label">Getting started</span>
          <h2 class="h2">How does Hekara work?</h2>
        </div>
        <p class="lede">Three steps from nothing to a live schedule your whole team shares.</p>
      </div>
      <ol class="steps reveal" style="list-style:none;margin:0;padding-left:0">
        <li class="step"><h3>Install it</h3><p>Run Hekara on your own server or cloud account, or have us install it for you.</p></li>
        <li class="step"><h3>Add your people</h3><p>Invite schedulers, caregivers and billing staff. Each one only sees what their role needs.</p></li>
        <li class="step"><h3>Plan the day</h3><p>Add patients and visits. Hekara shows who goes where, flags gaps and helps you fill them.</p></li>
        <li class="step"><h3>Stay on top of it</h3><p>Get warned about overtime and expiring certificates, and send claims for completed visits.</p></li>
      </ol>
    </div>
  </section>

  <section class="band-tight">
    <div class="wrap">
      <div class="facts">
        <div class="fact"><strong>4 roles</strong><span>Admin, scheduler, caregiver and billing, enforced on the server</span></div>
        <div class="fact"><strong>~50 KB</strong><span>Gzipped client. No Redis, no message broker</span></div>
        <div class="fact"><strong>0 per-seat</strong><span>fees. Add caregivers without adding cost</span></div>
        <div class="fact"><strong>1 test suite</strong><span>every hosting adapter must pass, so you can move</span></div>
      </div>
    </div>
  </section>

  <section class="band band-alt" id="why">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="label">The problem</span>
          <h2 class="h2">What problems does Hekara solve?</h2>
        </div>
        <p class="lede">The cost shows up as late-found open shifts, overtime discovered after payroll, missed credential renewals and an hour on the phone for every callout.</p>
      </div>
      <div class="ptable reveal">
        <div class="prow head"><span>The everyday problem</span><span>What Hekara does</span><span>What you gain</span></div>
        {problems.map(([q, a, g]) => (
          <div class="prow"><div class="q">{q}</div><div class="a">{a}</div><div class="g">{g}</div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="product">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="label">Features</span>
          <h2 class="h2">What can you do with Hekara?</h2>
        </div>
        <p class="lede">Scheduling, staffing, compliance and billing in one system, so nothing falls between four tools.</p>
      </div>
      <div class="tour">
        {features.map((f, i) => (
          <article class={`feature reveal${i % 2 ? " flip" : ""}`} id={f.id}>
            <div class="copy">
              <span class="feature-num">0{i + 1}</span>
              <h3 class="h3">{f.title}</h3>
              <p>{f.body}</p>
              <ul class="ticks">{f.ticks.map((t) => <li>{t}</li>)}</ul>
            </div>
            <div class="frame"><img src={`${base}images/${f.img}`} alt={f.alt} loading="lazy" width="1600" height="1000" /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-dark" id="security">
    <div class="wrap arch-grid">
      <div class="reveal">
        <span class="label">Security &amp; architecture</span>
        <h2 class="h2" style="margin-top:18px">How does Hekara keep patient data safe?</h2>
        <p style="margin-top:20px;max-width:520px">Patient fields are encrypted before they reach storage. Every read and write of patient data is audited. Every query is scoped to one agency.</p>
        <dl class="safeguards">
          <div><dt>Encryption</dt><dd>AES-256-GCM per field with a random IV and versioned key IDs</dd></div>
          <div><dt>Sign-in</dt><dd>Passkeys by default; Argon2id passwords and TOTP as fallbacks</dd></div>
          <div><dt>Audit log</dt><dd>Hash-chained per agency, with an integrity check and a daily verify</dd></div>
          <div><dt>Access</dt><dd>Invite-only accounts; caregivers see only their own visits</dd></div>
          <div><dt>Browser</dt><dd>Strict CSP; no third-party requests from the app</dd></div>
        </dl>
        <p class="note">Honest status: Hekara has not been independently audited or certified yet. <a href={`${repo}/blob/main/docs/SECURITY.md`} target="_blank" rel="noopener" style="color:#fff">Read the threat model →</a></p>
      </div>
      <div class="diagram reveal" aria-label="Architecture: the app depends on ports, adapters implement them per platform">
        <div class="layer"><b>Hekara app</b><small>Hono server + SolidJS client. Pure scheduling logic, Valibot validation at every boundary.</small></div>
        <div class="connector"></div>
        <div class="layer accent"><b>Ports</b><small>Repository · Realtime · Queue · Blob · Crypto · Secrets · Audit · Clock</small></div>
        <div class="connector"></div>
        <div class="adapters">
          <div class="layer accent"><b>Node · shipping</b><div class="chips"><span class="chip">Postgres</span><span class="chip">SSE</span><span class="chip">S3 / disk</span></div></div>
          <div class="layer"><b>Cloudflare · next</b><div class="chips"><span class="chip">Durable Objects</span><span class="chip">R2</span><span class="chip">Queues</span></div></div>
          <div class="layer"><b>AWS · planned</b><div class="chips"><span class="chip">RDS</span><span class="chip">SQS</span><span class="chip">KMS</span></div></div>
        </div>
        <p class="small" style="margin-top:18px;color:#8fb0a6">One contract test suite every adapter must pass, so a new platform is an adapter, not a rewrite.</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="label">How it compares</span>
          <h2 class="h2">How does Hekara compare to other options?</h2>
        </div>
        <p class="lede">Hekara isn't the right fit if you need a certified vendor-run service today. If you want control, and help when you need it, it's built for you.</p>
      </div>
      <div class="table-scroll reveal">
        <table class="compare">
          <thead><tr><th></th><th>Spreadsheets &amp; chat</th><th>Hosted per-seat software</th><th class="us">Hekara</th></tr></thead>
          <tbody>
            <tr><th>Live shared view of the day</th><td>No</td><td>Yes</td><td class="us">Yes</td></tr>
            <tr><th>One-click shift filling and overtime checks</th><td>No</td><td>Varies</td><td class="us">Yes</td></tr>
            <tr><th>You own the data and where it runs</th><td>Scattered</td><td>No</td><td class="us">Yes</td></tr>
            <tr><th>Cost grows with every user</th><td>No</td><td>Yes</td><td class="us">No</td></tr>
            <tr><th>Read, change and extend the code</th><td>n/a</td><td>No</td><td class="us">Yes</td></tr>
            <tr><th>Independent certifications</th><td>n/a</td><td>Often</td><td class="us">Not yet · <a href={`${base}services#compliance`}>readiness help</a></td></tr>
            <tr><th>Someone to call when it breaks</th><td>No</td><td>Yes</td><td class="us">Community or <a href={`${base}services`}>paid support</a></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band band-alt" id="services">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <span class="label">Services</span>
          <h2 class="h2">Can you set up Hekara for us?</h2>
        </div>
        <p class="lede">Yes. We install, customise and support Hekara inside your own cloud account or servers, with a written scope up front.</p>
      </div>
      <div class="cards cards-4 reveal">
        <a class="card" href={`${base}services#build`}><div class="card-num">01</div><h3>Custom builds</h3><p>Features, workflows and integrations shaped around how your agency runs.</p><span class="meta">EHR · payroll · SSO →</span></a>
        <a class="card" href={`${base}services#deploy`}><div class="card-num">02</div><h3>Hardened deployment</h3><p>Hosting, keys, backups and access reviews designed for patient data.</p><span class="meta">AWS · GCP · Azure · on-prem →</span></a>
        <a class="card" href={`${base}services#compliance`}><div class="card-num">03</div><h3>Compliance readiness</h3><p>HIPAA, SOC 2, ISO 27001 and HITRUST gap work, policies and evidence.</p><span class="meta">Audit preparation →</span></a>
        <a class="card card-dark" href={`${base}services#support`}><div class="card-num" style="color:var(--lime)">04</div><h3>Support &amp; licensing</h3><p>Response-time plans, upgrades, training, or a commercial licence.</p><span class="meta" style="color:#8fb0a6">Plans and terms →</span></a>
      </div>
    </div>
  </section>

  <section class="band" id="open-source">
    <div class="wrap split">
      <div class="reveal stack-lg">
        <span class="label">Open source</span>
        <h2 class="h2">Is Hekara really open source?</h2>
        <p class="lede">Yes. Every line is on GitHub under the AGPL-3.0 licence. You can use it for free, read it, change it and run it yourself. Try the demo on your laptop, then decide.</p>
        <ul class="ticks">
          <li>Strict TypeScript, unit and contract tests on every change</li>
          <li>Architecture, security and portability decisions written down in <code>docs/</code></li>
          <li>20% of sponsorship funds paid bounties for merged contributions</li>
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href={repo} target="_blank" rel="noopener">Star on GitHub <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href={`${repo}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">Contribute</a>
          <a class="btn btn-ghost" href={`${base}sponsor`}>Sponsor</a>
        </div>
      </div>
      <pre class="terminal reveal" aria-label="Quick start commands"><span class="c"># Node 24+, pnpm and Docker</span>
<span class="p">$ </span>git clone https://github.com/Srinivas26k/Hekara.git
<span class="p">$ </span>cd Hekara &amp;&amp; cp .env.example .env
<span class="p">$ </span>pnpm install
<span class="p">$ </span>pnpm keygen            <span class="c"># paste keys into .env</span>
<span class="p">$ </span>docker compose up -d db
<span class="p">$ </span>pnpm db:migrate
<span class="p">$ </span>DEMO_PASSWORD='…' pnpm db:seed
<span class="p">$ </span>pnpm build &amp;&amp; pnpm start
<span class="c"># → http://localhost:3000</span></pre>
    </div>
  </section>

  <section class="band band-alt">
    <div class="wrap faq-grid">
      <div class="reveal">
        <span class="label">Questions</span>
        <h2 class="h2" style="margin-top:18px">Frequently asked questions</h2>
        <p class="muted" style="margin-top:18px">Something else? <a href={`${base}contact`}>Ask us directly</a>.</p>
      </div>
      <div class="faq reveal">
        {faqs.map(([q, a]) => (<details><summary>{q}</summary><p>{a}</p></details>))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  })} />

  <section class="band" style="padding-bottom:0">
    <div class="wrap">
      <div class="cta on-dark reveal">
        <div>
          <h2 class="h2">Ready to run your agency on Hekara?</h2>
          <p>A short form, a personal reply, and a written scope before any work starts.</p>
        </div>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href={`${base}contact`}>Start a project <span class="arrow">→</span></a>
          <a class="btn btn-ghost btn-lg" href={repo} target="_blank" rel="noopener">View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
