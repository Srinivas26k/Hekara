---
import "../styles/styles.css";
import { GRAPH } from "../data/site";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Hekara is open-source home health agency software: live scheduling, one-click shift filling, credential tracking, billing and encrypted patient records on servers you control.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "");
const repo = "https://github.com/Srinivas26k/Hekara";
const nav = [
  { href: `${base}#product`, label: "Product" },
  { href: `${base}#security`, label: "Security" },
  { href: `${base}#open-source`, label: "Open source" },
  { href: `${base}services`, label: "Services" },
  { href: `${base}sponsor`, label: "Sponsor" },
];
const current = (href: string) => href.replace(/\/$/, "") === path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f4ef" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <link rel="alternate" type="text/plain" title="LLM summary" href={`${base}llms.txt`} />
    <link rel="author" type="text/plain" href={`${base}humans.txt`} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Hekara: open-source home health agency software" />
    <link rel="preload" href={`${base}fonts/inter-latin-var.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hekara" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://srinivas26k.github.io/Hekara/social-preview.png" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://srinivas26k.github.io/Hekara/social-preview.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(GRAPH)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={base} aria-label="Hekara home">
          <img src={`${base}logo-symbol.svg`} alt="" width="30" height="30" />
          hekara
        </a>
        <nav class="nav" id="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="ph-small" href="https://www.producthunt.com/products/hekara?utm_source=badge-follow&utm_medium=badge&utm_source=badge-hekara" target="_blank" rel="noopener noreferrer"><img src="https://api.producthunt.com/widgets/embed-image/v1/follow.svg?product_id=1389418&theme=light&size=small" alt="Follow Hekara on Product Hunt" width="86" height="32" /></a>
          <a class="gh-link" href={repo} target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
          <a class="btn btn-primary btn-sm" href={`${base}contact`}>Start a project</a>
        </div>
        <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span></span><span></span></button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand" href={base}><img src={`${base}logo-symbol-reversed.svg`} alt="" width="30" height="30" /> hekara</a>
            <p>Open-source operations software for home health agencies. Self-hosted, encrypted, and yours to change.</p>
            <div class="ph-badges" aria-label="Hekara on Product Hunt">
              <a href="https://www.producthunt.com/products/hekara/reviews/new?utm_source=badge-product_review&utm_medium=badge&utm_source=badge-hekara" target="_blank" rel="noopener noreferrer"><img src="https://api.producthunt.com/widgets/embed-image/v1/product_review.svg?product_id=1389418&theme=light" alt="Review Hekara on Product Hunt" width="250" height="54" loading="lazy" /></a>
              <a href="https://www.producthunt.com/products/hekara?utm_source=badge-follow&utm_medium=badge&utm_source=badge-hekara" target="_blank" rel="noopener noreferrer"><img src="https://api.producthunt.com/widgets/embed-image/v1/follow.svg?product_id=1389418&theme=light" alt="Follow Hekara on Product Hunt" width="250" height="54" loading="lazy" /></a>
            </div>
          </div>
          <div>
            <h2 class="footer-h">Product</h2>
            <ul>
              <li><a href={`${base}#product`}>Features</a></li>
              <li><a href={`${base}#security`}>Security</a></li>
              <li><a href={`${repo}#quick-start`} target="_blank" rel="noopener">Quick start</a></li>
              <li><a href={`${repo}/blob/main/docs/ROADMAP.md`} target="_blank" rel="noopener">Roadmap</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footer-h">Work with us</h2>
            <ul>
              <li><a href={`${base}services`}>Services</a></li>
              <li><a href={`${base}services#compliance`}>Compliance readiness</a></li>
              <li><a href={`${base}contact`}>Start a project</a></li>
              <li><a href={`${base}sponsor`}>Sponsor</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footer-h">Project</h2>
            <ul>
              <li><a href={repo} target="_blank" rel="noopener">Source code</a></li>
              <li><a href={`${repo}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">Contribute</a></li>
              <li><a href={`${repo}/blob/main/SECURITY.md`} target="_blank" rel="noopener">Report a vulnerability</a></li>
              <li><a href={`${base}privacy`}>Privacy</a> · <a href={`${base}terms`}>Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© <span id="year">2026</span> Hekara · <a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener">AGPL-3.0</a></span>
          <span>No cookies. No analytics. Fonts served from this site.</span>
        </div>
      </div>
    </footer>

    <script is:inline src={`${base}script.js`} defer></script>
  </body>
</html>
