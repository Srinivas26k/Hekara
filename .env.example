# =============================================================================
# Hekara configuration
#
# Copy this file to `.env` and fill it in:   cp .env.example .env
# `.env` is git-ignored. NEVER commit it, paste it into an issue, or share it:
# it holds the keys that protect patient data.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Runtime mode. Leave unset for local development.
# Set to "production" when deploying: it requires an https APP_URL, turns on
# Secure cookies, and disables the development-only `?at=HH:MM` clock override.
# NODE_ENV=production

# Port the server listens on (it binds to 127.0.0.1; put a reverse proxy or a
# tunnel in front of it for public access).
# Default: 3000
PORT=3000

# The public address people use to open the app, with no trailing slash.
# It is used for sign-in cookies, passkeys, invite links and the Origin check
# that blocks cross-site requests, so it must match what the browser shows.
#   local development:  http://localhost:3000
#   production:         https://app.your-agency.example   (https is required)
APP_URL=http://localhost:3000

# Set to 1 ONLY when a trusted proxy in front of the app sets the real client
# address in CF-Connecting-IP or X-Forwarded-For (Cloudflare Tunnel, a load
# balancer). Without it the socket address is used for rate limiting, which
# behind a proxy would make every visitor look like one person.
# Never enable it when the app is reachable directly: clients could then spoof
# their address.
# TRUST_PROXY=1

# Folder for uploaded or generated files. Created if missing.
# Default: ./.data/blobs
# BLOB_DIR=./.data/blobs


# -----------------------------------------------------------------------------
# Database (PostgreSQL 17)
# -----------------------------------------------------------------------------

# Connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# The value below matches `docker compose up -d db` (port 5442) for local use.
# In production use a strong password, a private network, and add
# `?sslmode=verify-full` so the connection is encrypted and verified.
DATABASE_URL=postgres://hekara:hekara@localhost:5442/hekara


# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

# Signs sessions and one-time links. Must be at least 32 random characters;
# the server refuses to start with a short value or the placeholder below.
# Generate one:   openssl rand -base64 48
# Changing it signs everyone out and invalidates unused invite links.
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48

# Master keys for field-level encryption of patient data (names, dates of
# birth, addresses, notes, care plans). A comma-separated list of  id:key  pairs
# where each key is 32 random bytes in base64.
# Generate a pair:   pnpm keygen        (prints both lines below)
#
# !! BACK THESE UP somewhere safe and separate from the database. If the key is
# !! lost, the encrypted data CANNOT be recovered. Anyone holding the key and a
# !! database copy can read the data, so keep it out of the repo and out of logs.
#
# To rotate: generate a new key under a new id, add it to the list (keep the old
# one so existing data stays readable), and point DATA_KEY_ID at the new id.
DATA_KEYS=k1:replace-with-generated-key

# Which id in DATA_KEYS is used to encrypt NEW data.
DATA_KEY_ID=k1


# -----------------------------------------------------------------------------
# Demo data (only used by `pnpm db:seed`)
# -----------------------------------------------------------------------------

# Password given to the demo accounts (admin@, scheduler@, caregiver@ and
# billing@juniper.test). Use at least 12 characters. If unset, a random password
# is generated and printed once. Demo data is for local development only: do not
# seed a production database.
# DEMO_PASSWORD=choose-a-long-password
