# Required
DATABASE_URL=postgres://hekara:hekara@localhost:5442/hekara
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48
APP_URL=http://localhost:3000

# Optional
# RUN_MIGRATIONS=true
# ANTHROPIC_API_KEY=

# Field-encryption master keys: id:base64(32 bytes). Generate: pnpm --filter @hekara/web keygen
DATA_KEYS=k1:replace-with-generated-key
DATA_KEY_ID=k1
